# Copy to backend/.env. Every value is optional: with no keys the app runs in demo mode.

# Provider: anthropic | openai | mock. Empty picks by available key (Anthropic first), else mock.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. The public demo uses claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
# Required for the OpenAI provider, for example a current GPT model id.
OPENAI_MODEL=

# Frontend origins allowed by CORS (comma separated).
CORS_ORIGINS=http://localhost:3040

# Where SQLite and uploaded files live.
DATA_DIR=./data

# Public demo preset: 10 MB / 10 pages per file, 15 files per batch, 20 live documents per IP
# per hour, 200 per day, samples in demo mode, everything deleted after one hour.
PUBLIC_DEMO=false
# Set when running behind a proxy you trust (Cloud Run), so per-IP limits see the real client.
TRUST_PROXY_HEADERS=false
